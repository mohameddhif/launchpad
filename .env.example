# --- Postgres ---
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=launchpad
POSTGRES_DB=launchpad
POSTGRES_PORT=5432
# Host-side connection string, used by npm scripts run outside Docker (db:migrate, db:seed,
# db:studio). The api/worker containers use their own DATABASE_URL (host "postgres"),
# hardcoded in docker-compose.yml — this one is for tools running on your machine.
DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
ADMIN_EMAIL=admin@example.com
# Local-only default. Use a unique long password in the production environment file.
ADMIN_PASSWORD=change-me
# Local-only default. Generate a unique value for production (see README).
JWT_SECRET=dev-only-change-me-please-32chars+

# --- Secrets encryption (32-byte key, base64) ---
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Deploy target ---
DEPLOY_DOMAIN=127.0.0.1.nip.io
TLS_ENABLED=false
DOCKER_NETWORK=deploy-net

# --- Preview deployments ---
# How many builds per preview branch stay live on their immutable URLs.
PREVIEW_CONTAINERS_PER_BRANCH=3
# A preview branch with no push in this many days is torn down by the cleanup sweep.
STALE_PREVIEW_DAYS=1
CLEANUP_INTERVAL_MS=3600000

# --- Ports ---
# Host-side port only; the api container always listens on 4000 internally.
# Matches the dashboard's Vite proxy default (apps/dashboard/vite.config.ts).
API_PORT=4100
WORKER_CONCURRENCY=2

# --- Production only (docker-compose.production.yml) ---
# These must be publicly resolvable names. DASHBOARD_ORIGIN is normally
# https://console.example.com and DASHBOARD_DOMAIN is console.example.com.
DASHBOARD_ORIGIN=
DASHBOARD_DOMAIN=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Set to true only after the wildcard certificate has been issued.
# The production compose file defaults this to true.
# TLS_ENABLED=true
# The included DNS-01 automation supports Cloudflare. Create a least-privilege token
# with DNS Edit for this zone; never commit it.
CERTBOT_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
